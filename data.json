  "faqs": [
    {
      "q": "Does Stash read every Remita receipt correctly?",
      "a": "Scanning works best on clear, well-lit photos. You can always edit the RRR, amount or date before saving if the scan gets something wrong."
    },
    {
      "q": "Can someone else open my files with a cafe PIN?",
      "a": "A PIN opens only the one document you choose, and it expires after 10 minutes."
    },
    {
      "q": "What happens if I lose network on campus?",
      "a": "Stash needs a connection to load its scanning and PDF tools. Files you have already saved stay in this browser on this device."
    },
    {
      "q": "How is my data stored?",
      "a": "For now your documents and details are stored in this browser, on this device, and scanning runs on your device. Cloud storage and sync aren\u2019t available yet."
    }
  ]
