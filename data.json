  "faqs": [
    {
      "q": "Does Stash read every Remita receipt correctly?",
      "a": "Scanning works best on clear, well-lit photos. You can always edit the RRR, amount or date before saving if the scan gets something wrong."
    },
    {
      "q": "Can someone else open my files with a cafe PIN?",
      "a": "Only the one document you choose is exposed, only for the time you set, and the PIN stops working after first use or when it expires."
    },
    {
      "q": "What happens if I lose network on campus?",
      "a": "With offline access on, previously opened files and your saved metadata stay available, and anything you add will sync once you're back online."
    },
    {
      "q": "How is my data stored?",
      "a": "Files are scanned and processed on your own device before upload, then kept in your private storage bucket tied to your student account."
    }
  ]
